# The rizzy-vault server image (ADR 0010 §4; ROADMAP §4.9; operator guide: docs/self-hosting.md).
#
# One image, one static binary, every role, with the web vault embedded (`embed-web`). Build
# from the repository root:
#
#   docker build -f deploy/Containerfile -t localhost/rizzy-vault:dev .
#   podman build -f deploy/Containerfile -t localhost/rizzy-vault:dev .
#
# Multi-arch (amd64, arm64), each architecture built natively (under emulation on a foreign
# host), so the C parts (bundled SQLite, ring) never need a cross toolchain:
#
#   docker buildx build --platform linux/amd64,linux/arm64 -f deploy/Containerfile -t <name> .
#   podman build --platform linux/amd64,linux/arm64 --manifest <name> -f deploy/Containerfile .
#
# Stages (ADR 0010 §4: "The image build runs `pnpm build` for `apps/web`, then builds
# `rizzy-server` with `embed-web`. Release images always have it."):
#   1. `wasm`: wasm-bindgen-cli at the version Cargo.lock pins for wasm-bindgen, then
#      `cargo xtask build-wasm`, which writes packages/core/generated/ (ADR 0013 §4);
#   2. `web`: Node.js and pnpm; `pnpm install --frozen-lockfile` (no install scripts run:
#      pnpm-workspace.yaml `onlyBuiltDependencies: []`, ADR 0014 §3), then `pnpm run build`,
#      which writes apps/web/dist/;
#   3. `build`: the static musl server with `--features embed-web`, which embeds apps/web/dist/;
#   4. the distroless runtime.
#
# Base images are pinned by tag and digest. The Rust and runtime digests are the multi-arch
# index digests the registries served on 2026-09-29 (read from a containerd image store after a
# pull); the Node.js digest is the OCI index digest registry-1.docker.io served for its tag on
# 2026-10-01 (amd64 and arm64 in it). To update: pull the new tag, read
# `docker image inspect --format "{{json .RepoDigests}}" <tag>` on a containerd store (or
# `docker buildx imagetools inspect <tag>`), and replace both parts together.
# Reproducible, signed images are M8 (ADR 0010 §4, ROADMAP §4.9).
#
# Honest limits: wasm-bindgen-cli is built from its upstream lockfile (`cargo install --locked`);
# ADR 0019 §4.1's repository-owned lockfile and approval record for it do not exist yet. pnpm is
# installed from the npm registry at the exact version `package.json` names (`packageManager`),
# verified by npm against the registry's own integrity hash only.

ARG RUST_IMAGE=docker.io/library/rust:1.94.1-alpine@sha256:77237dd363a0b127bb5ef532c2d64c0deb380b738e43a9c4bdac73398d6d0a08
ARG NODE_IMAGE=docker.io/library/node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# ---- wasm: the core as WebAssembly, and its JavaScript glue -------------------------------------
FROM ${RUST_IMAGE} AS wasm

# The C compiler and musl headers for the bundled SQLite and ring. Rust itself comes from
# rust-toolchain.toml: rustup downloads from static.rust-lang.org the pinned channel if the
# image's differs, and the file's components (rustfmt, clippy) and wasm32 target, which the
# image's minimal profile lacks. The build therefore needs that host as well as crates.io
# (docs/self-hosting.md §2).
RUN apk add --no-cache gcc musl-dev

# The bindings generator, before the sources, so that this layer is cached across source
# changes. Its version must equal wasm-bindgen's in Cargo.lock: `cargo xtask build-wasm`
# refuses any other (ADR 0013 §4). Bump the two together.
ARG WASM_BINDGEN_VERSION=0.2.129
RUN cargo install --locked --root /opt/wasm-bindgen wasm-bindgen-cli --version "${WASM_BINDGEN_VERSION}"

WORKDIR /src
COPY . .

# `--locked` inside xtask: exactly Cargo.lock.
RUN WASM_BINDGEN=/opt/wasm-bindgen/bin/wasm-bindgen cargo xtask build-wasm

# ---- web: the web vault's static files ----------------------------------------------------------
FROM ${NODE_IMAGE} AS web

# `--ignore-scripts`: nothing runs at install time. Keep in step with `packageManager` in
# package.json.
ARG PNPM_VERSION=10.30.2
RUN npm install --global --ignore-scripts "pnpm@${PNPM_VERSION}"

WORKDIR /src
COPY . .
COPY --from=wasm /src/packages/core/generated packages/core/generated

# `--frozen-lockfile`: exactly pnpm-lock.yaml. `pnpm run build` type-checks and builds every
# package, ending with apps/web/dist/.
RUN pnpm install --frozen-lockfile \
 && pnpm run build \
 && test -f apps/web/dist/index.html

# ---- build: a static musl binary with the web vault embedded ------------------------------------
FROM wasm AS build

COPY --from=web /src/apps/web/dist apps/web/dist

# `--locked`: exactly Cargo.lock. The release profile (root Cargo.toml) has `panic = "abort"`.
# The binary is static: musl is the host target of this image and links statically by default.
# No `RUN --mount` cache: the classic Docker builder has no BuildKit mounts, and one
# Containerfile must build under Docker (with or without BuildKit), Podman and Buildah.
RUN cargo build --locked --release -p rizzy-server --bin rizzy-vault --features embed-web \
 && install -D -m 0755 target/release/rizzy-vault /out/rizzy-vault \
 && install -d -m 0700 /out/data /out/rizzy-secrets

# ---- runtime: distroless, no shell, no package manager -----------------------------------------
FROM ${RUNTIME_IMAGE}

COPY --from=build /out/rizzy-vault /usr/local/bin/rizzy-vault

# The two writable paths, owned by the non-root user so that an empty named volume mounted
# there inherits that owner (Docker and Podman copy it up):
# - /data: the SQLite database, its writer lock, WAL and the pre-migration copy (ADR 0011);
# - /run/rizzy-secrets: the secrets file, a separate volume that is read-only for the server
#   and writable only for the one-off `secrets init` / `secrets rotate` (ADR 0010 §4, INV-50).
COPY --from=build --chown=65532:65532 /out/data /data
COPY --from=build --chown=65532:65532 /out/rizzy-secrets /run/rizzy-secrets

# distroless "nonroot": UID and GID 65532. Every listener uses an unprivileged port.
USER 65532:65532

ENV RIZZY_LISTEN=0.0.0.0:8080 \
    RIZZY_DATA_DIR=/data \
    RIZZY_SECRETS_FILE=/run/rizzy-secrets/secrets.json

EXPOSE 8080

# The root filesystem can be read-only: the server writes only to /data (and SQLite to a /tmp
# tmpfs when it needs a temporary file). No HEALTHCHECK: the image has no shell or HTTP client;
# the proxy, or an external monitor, checks `GET /api/meta`.
ENTRYPOINT ["/usr/local/bin/rizzy-vault"]
CMD ["serve"]
