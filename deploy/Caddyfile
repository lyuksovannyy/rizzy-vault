# The TLS reverse proxy of profile A (ADR 0010 §4, owner decision 3: a Caddy example; the
# binary has no ACME client in M1). Caddy obtains and renews the certificate for RIZZY_DOMAIN
# and forwards everything to the rizzy-vault container. Operator guide: docs/self-hosting.md.
{
	# No admin endpoint inside the proxy container.
	admin off
}

{$RIZZY_DOMAIN} {
	# Caddy replaces any X-Forwarded-For a client sends with the client's address (it trusts
	# no upstream proxy unless configured to), and rizzy-vault believes that header only from
	# this proxy's address (RIZZY_TRUSTED_PROXIES; THREAT_MODEL §7.6 "S", §7.14).
	#
	# No `encode` (compression): responses carry session tokens next to attacker-influenced
	# data. No access log: rizzy-vault logs no IP addresses, and neither should its proxy
	# unless the operator decides to (THREAT_MODEL §3.4).
	#
	# rizzy-vault sets HSTS, CSP and the other security headers itself (INV-49).
	#
	# The `icons` role's endpoints (item icons, ADR 0052 point 6; the breach check, ADR 0053)
	# go to its own container when it runs: set RIZZY_ICONS_UPSTREAM=icons:8080 (compose.yaml)
	# or rizzy-vault-icons:8080 (Quadlet). The default sends them to rizzy-vault, which answers
	# 404 not_found, the "not enabled" the clients expect. Matched before the catch-all.
	reverse_proxy /api/v1/icons/* {$RIZZY_ICONS_UPSTREAM:rizzy-vault:8080}
	reverse_proxy rizzy-vault:8080
}
