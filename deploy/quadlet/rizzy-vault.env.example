# Copy to rizzy-vault.env (next to the unit files, see docs/self-hosting.md §13) and edit.
# Unlike deploy/.env (which compose.yaml only reads to substitute ${VAR} while parsing the
# YAML, never as container environment), Quadlet's EnvironmentFile= passes every line of this
# file straight into the rizzy-vault container's process environment, the way compose.yaml's
# `environment:` block does for the same five settings. Full reference of every RIZZY_* setting:
# docs/self-hosting.md "Configuration reference" (§4).
#
# RIZZY_LISTEN is not here: compose.yaml hardcodes it too, and so does
# rizzy-vault.container's own Environment= line.

# The canonical origin clients use, bound into OPAQUE and every device signature. It must be
# exactly what users type: scheme, host and, if not 443, the port (for example
# https://vault.example.com:8443 when the host port 8443 is published directly). Changing it
# later locks every existing account out.
RIZZY_ORIGIN=https://vault.example.com

# closed (default) or open. Open only while you create the first accounts (guide: "First run").
RIZZY_SIGNUP=closed

# error, warn, info (default) or debug.
RIZZY_LOG_LEVEL=info

# How many hours the server waits between a valid recovery code and releasing the account, so
# that an enrolled device can cancel a recovery started with a stolen Emergency Kit. 72 by
# default, 0 to 720 (30 days). 0 only on a single-account instance (guide: "Configuration
# reference").
RIZZY_RECOVERY_WAIT_HOURS=72

# The reverse proxy's address on the rizzy-vault-edge network (ADR 0010 §4; self-hosting.md
# §6). Must match the IP= in rizzy-vault-proxy.container and the Subnet= in
# rizzy-vault-edge.network — change all three together.
RIZZY_TRUSTED_PROXIES=172.30.87.10
