# Copy to rizzy-vault-icons.env (next to the unit files, see docs/self-hosting.md §13) and edit.
# Read by rizzy-vault-icons.container, as compose.yaml's `icons.environment` block reads
# deploy/.env.

# The breach check of Password health (ADR 0053 item 5): off or on. Item icons are on whenever
# the role runs.
RIZZY_BREACH_CHECK=off

# The cache: 14 days, 256 MiB (ADR 0052 owner answer 3).
RIZZY_ICON_CACHE_TTL_SECS=1209600
RIZZY_ICON_CACHE_MAX_BYTES=268435456

# The proxy's fixed address (rizzy-vault-proxy.container's IP=): its X-Forwarded-For is the
# only one the per-address rate limit believes.
RIZZY_TRUSTED_PROXIES=172.30.87.10

RIZZY_LOG_LEVEL=info
