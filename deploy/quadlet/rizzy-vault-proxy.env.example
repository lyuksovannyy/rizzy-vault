# Copy to rizzy-vault-proxy.env (next to the unit files, see docs/self-hosting.md §13) and
# edit. Passed into the Caddy container the way compose.yaml's `proxy.environment` block
# passes RIZZY_DOMAIN, read by ../Caddyfile as `{$RIZZY_DOMAIN}`.

# The public host name the proxy gets a certificate for.
RIZZY_DOMAIN=vault.example.com

# Where /api/v1/icons/ goes (ADR 0052 point 6): rizzy-vault itself by default (it answers
# 404, "not enabled"); rizzy-vault-icons:8080 once rizzy-vault-icons.container runs.
# RIZZY_ICONS_UPSTREAM=rizzy-vault-icons:8080
