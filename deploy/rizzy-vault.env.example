# Copy to deploy/.env and edit. docker compose and podman compose read .env next to
# compose.yaml. .env is in .gitignore. It holds no secret in profile A: the server secrets are
# in their own volume (rizzy-vault-secrets), never in the environment.
# Reference of every setting: docs/self-hosting.md "Configuration reference".

# The public host name the proxy gets a certificate for.
RIZZY_DOMAIN=vault.example.com

# The canonical origin clients use, bound into OPAQUE and every device signature. It must be
# exactly what users type: scheme, host and, if not 443, the port (for example
# https://vault.example.com:8443 when the host port 8443 is published directly). Changing it
# later locks every existing account out.
RIZZY_ORIGIN=https://vault.example.com

# closed (default) or open. Open only while you create the first accounts (guide: "First run").
RIZZY_SIGNUP=closed

# error, warn, info (default) or debug.
RIZZY_LOG_LEVEL=info

# How many hours the server waits between a valid recovery code and releasing the account, so
# that an enrolled device can cancel a recovery started with a stolen Emergency Kit. 72 by
# default, 0 to 720 (30 days). 0 only on a single-account instance (guide: "Configuration
# reference").
RIZZY_RECOVERY_WAIT_HOURS=72

# Host ports of the proxy (ADR 0010 §4: high ports by default, for rootless Podman).
RIZZY_HTTP_PORT=8080
RIZZY_HTTPS_PORT=8443

# The image to run; `docker compose build` tags the local build with this name.
RIZZY_IMAGE=localhost/rizzy-vault:dev

# The proxy image. Pin it by digest in production (docker.io/library/caddy:2-alpine@sha256:...).
RIZZY_PROXY_IMAGE=docker.io/library/caddy:2-alpine

# The `edge` network and the proxy's fixed address on it (RIZZY_TRUSTED_PROXIES). Change both
# together if the subnet collides with one of your networks.
RIZZY_EDGE_SUBNET=172.30.87.0/24
RIZZY_PROXY_IP=172.30.87.10

# Where `backup-secrets` writes the encrypted secrets backup (guide: "The secrets file"). Keep it
# apart from the database archives (./backup-db in the guide), preferably outside this checkout:
# never one directory, archive or backup job for both (THREAT_MODEL INV-50).
RIZZY_SECRETS_BACKUP_DIR=./backup-secrets
