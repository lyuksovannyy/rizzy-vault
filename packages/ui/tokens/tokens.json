{
  "color": {
    "light": {
      "bg": "#f7f7f8",
      "surface": "#ffffff",
      "border": "#c9cad1",
      "text": "#17181c",
      "text-muted": "#4d505b",
      "accent": "#2f4fd6",
      "on-accent": "#ffffff",
      "danger": "#b3261e",
      "on-danger": "#ffffff",
      "warning-bg": "#fff4d6",
      "warning-text": "#4a3500",
      "focus": "#2f4fd6"
    },
    "dark": {
      "bg": "#121317",
      "surface": "#1c1d23",
      "border": "#3b3d47",
      "text": "#ececf1",
      "text-muted": "#b4b6c2",
      "accent": "#8fa6ff",
      "on-accent": "#0b1030",
      "danger": "#ffb4ab",
      "on-danger": "#410002",
      "warning-bg": "#3a2c00",
      "warning-text": "#ffe08a",
      "focus": "#8fa6ff"
    }
  },
  "contrast-pairs": [
    { "fg": "text", "bg": "bg", "min-ratio": 4.5 },
    { "fg": "text", "bg": "surface", "min-ratio": 4.5 },
    { "fg": "text-muted", "bg": "bg", "min-ratio": 4.5 },
    { "fg": "on-accent", "bg": "accent", "min-ratio": 4.5 },
    { "fg": "on-danger", "bg": "danger", "min-ratio": 4.5 },
    { "fg": "danger", "bg": "bg", "min-ratio": 4.5 },
    { "fg": "danger", "bg": "surface", "min-ratio": 4.5 },
    { "fg": "warning-text", "bg": "warning-bg", "min-ratio": 4.5 },
    { "fg": "focus", "bg": "bg", "min-ratio": 3.0 },
    { "fg": "focus", "bg": "surface", "min-ratio": 3.0 }
  ],
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem"
  },
  "type": {
    "font-body": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "font-size-small": "0.875rem",
    "font-size-body": "1rem",
    "font-size-title": "1.375rem"
  },
  "radius": {
    "1": "4px",
    "2": "8px"
  },
  "shadow": {
    "light": {
      "1": "0 1px 2px rgba(0, 0, 0, 0.12)",
      "2": "0 4px 12px rgba(0, 0, 0, 0.16)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "2": "0 4px 16px rgba(0, 0, 0, 0.55)"
    }
  }
}
