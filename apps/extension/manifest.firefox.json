{
  "manifest_version": 2,
  "name": "rizzy-vault",
  "version": "0.0.0",
  "description": "Self-hostable, end-to-end encrypted, zero-knowledge password manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@rizzy-vault.example.invalid",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "idle", "http://*/*", "https://*/*"],
  "background": {
    "page": "src/core-host/background-page.html",
    "persistent": true
  },
  "browser_action": {
    "default_popup": "src/popup/index.html",
    "default_title": "rizzy-vault"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content-script.js"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*"],
      "js": ["src/content/passkey-relay.js"],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["src/inline-menu/index.html", "src/passkey-consent/index.html", "src/save-dialog/index.html", "src/content/passkey-page-shim.js"],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'"
}
